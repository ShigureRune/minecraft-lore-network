// 関係図 v1.06 / 考察MD v3.21 / 2026-11-27
// 更新: media=媒体、dimensions=存在次元、origin_dimensions=起源候補（根拠は origin_note）。下線・左記号は生成スクリプトで描画。
// 再生成: python render_lore_map.py minecraft_lore_map.dot minecraft_lore_map.svg
// 実線＝MDに記録された仕様・描写、破線＝独自仮説・比較。
digraph lore {
 graph [id="lore_map", layout=neato, bgcolor="#ffffff", fontname="Noto Sans CJK JP", fontsize=22, labelloc=t, label=<<FONT POINT-SIZE="25">Minecraft 世界観・考察関係図 v1.06</FONT><BR/><FONT POINT-SIZE="17">考察MD v3.21 ｜ 実線：記録された仕様・描写 ／ 破線：仮説・比較</FONT><BR/><FONT POINT-SIZE="16"><FONT COLOR="#1859a0">魂・経験値・付呪</FONT>　｜　<FONT COLOR="#7945a5">音・情報・シフト</FONT>　｜　<FONT COLOR="#287449">生命・召喚・回復</FONT>　｜　<FONT COLOR="#007c83">海洋・鉱物</FONT>　｜　<FONT COLOR="#b44436">汚染・災害</FONT>　｜　<FONT COLOR="#87551c">文明・勢力・技術</FONT>　｜　<FONT COLOR="#475569">次元・遺跡</FONT></FONT><BR/><FONT POINT-SIZE="16">下線（登場・描写の媒体）：<FONT COLOR="#238636"><U>本編</U></FONT>　｜　<FONT COLOR="#e07a19"><U>Dungeons</U></FONT>　｜　<FONT COLOR="#a536dc"><U>Dungeons II</U></FONT>　｜　<FONT COLOR="#168dc5"><U>Legends</U></FONT>　｜　<FONT COLOR="#d43869"><U>映画</U></FONT>　｜　<FONT COLOR="#9b6a29"><U>公式小説</U></FONT>　｜　下線なし＝不明・独自仮説</FONT><BR/><FONT POINT-SIZE="16">左記号（存在・描写された次元）：<FONT COLOR="#43a047">■ オーバーワールド</FONT>　｜　<FONT COLOR="#dc493a">▲ ネザー</FONT>　｜　<FONT COLOR="#a384cf">◆ エンド</FONT>　｜　<FONT COLOR="#169caa">● シフト</FONT>　｜　<FONT COLOR="#657080">◇ その他の次元</FONT>　｜　なし＝不明</FONT>>, pad=0.5, overlap=prism, sep="+44", esep="+10", splines=true, outputorder=edgesfirst, start=42, maxiter=4000, model=shortpath];
 node [shape=plaintext, fontname="Noto Sans CJK JP", fontsize=19, margin="0.69,0.16"];
 edge [fontname="Noto Sans CJK JP", fontsize=12, color="#8995a5", fontcolor="#475569", arrowsize=0.62, penwidth=1.1, len=3.0];

 // 魂・経験値・付呪
 soul [id="node_soul", label="魂（Dungeons系）", fontcolor="#1859a0", fontsize=22, media="D,D2", dimensions="O,S", origin_dimensions=""];
